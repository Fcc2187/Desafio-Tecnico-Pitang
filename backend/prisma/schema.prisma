generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  COLABORADOR
  GESTOR
  FINANCEIRO
  ADMIN
}

enum ReimbursementStatus {
  RASCUNHO
  ENVIADO
  APROVADO
  REJEITADO
  PAGO
  CANCELADO
}

enum HistoryAction {
  CREATED
  UPDATED
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  CANCELED
}

model User {
  id             String                 @id @default(uuid())
  nome           String
  email          String                 @unique
  senha          String
  perfil         Perfil
  criadoEm       DateTime               @default(now())
  atualizadoEm   DateTime               @updatedAt
  reimbursements Reimbursement[]
  history        ReimbursementHistory[]

  @@map("users")
}

model Category {
  id             String          @id @default(uuid())
  nome           String
  ativo          Boolean         @default(true)
  limiteValor    Decimal?        @db.Decimal(10, 2)
  criadoEm       DateTime        @default(now())
  atualizadoEm   DateTime        @updatedAt
  reimbursements Reimbursement[]

  @@map("categories")
}

model Reimbursement {
  id                    String                 @id @default(uuid())
  solicitanteId         String
  categoriaId           String
  descricao             String
  valor                 Decimal                @db.Decimal(10, 2)
  dataDespesa           DateTime
  status                ReimbursementStatus    @default(RASCUNHO)
  justificativaRejeicao String?
  criadoEm              DateTime               @default(now())
  atualizadoEm          DateTime               @updatedAt
  solicitante           User                   @relation(fields: [solicitanteId], references: [id])
  categoria             Category               @relation(fields: [categoriaId], references: [id])
  attachments           Attachment[]
  history               ReimbursementHistory[]

  @@map("reimbursements")
}

model Attachment {
  id            String        @id @default(uuid())
  solicitacaoId String
  nomeArquivo   String
  urlArquivo    String
  tipoArquivo   String
  criadoEm      DateTime      @default(now())
  solicitacao   Reimbursement @relation(fields: [solicitacaoId], references: [id])

  @@map("attachments")
}

model ReimbursementHistory {
  id            String        @id @default(uuid())
  solicitacaoId String
  usuarioId     String
  acao          HistoryAction
  observacao    String?
  criadoEm      DateTime      @default(now())
  solicitacao   Reimbursement @relation(fields: [solicitacaoId], references: [id])
  usuario       User          @relation(fields: [usuarioId], references: [id])

  @@map("reimbursement_history")
}
